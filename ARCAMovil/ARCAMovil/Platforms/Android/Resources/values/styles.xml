<?xml version="1.0" encoding="utf-8" ?>
<resources>
	<style name="Maui.MainTheme" parent="Theme.AppCompat.Light.DarkActionBar">

		<item name="android:statusBarColor">@color/statusBarColor</item>

		<item name="android:windowLightStatusBar">false</item>

	</style>

	<style name="Maui.SplashTheme" parent="Theme.SplashScreen">
		<item name="windowSplashScreenBackground">@color/colorPrimary</item>
		<item name="windowSplashScreenAnimatedIcon">@drawable/maui_splash_image</item>
		<item name="postSplashScreenTheme">@style/Maui.MainTheme</item>
	</style>
</resources>