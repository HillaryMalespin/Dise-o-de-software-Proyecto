<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ARCAMovil.Pages.BibliotecaPage"
             BackgroundColor="White"
             Title="Biblioteca">


    <ScrollView>
        <VerticalStackLayout Padding="20">
            <Label Text="Carpetas:"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,10" />

            <CollectionView ItemsSource="{Binding Carpetas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="0,5" CornerRadius="10" BackgroundColor="White" HasShadow="True">
                            <Label Text="{Binding Nombre}"
                       FontSize="18"
                       TextColor="DarkBlue"
                       VerticalOptions="Center" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
