<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ARCAMovil.Pages.ListaPdfPage"
             Title="Biblioteca"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Encabezado -->
        <Grid BackgroundColor="White" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="logo_arca.png" HeightRequest="30" Grid.Column="0" />
            <Label Text="ARCA" Grid.Column="1" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center" TextColor="#003366" FontAttributes="Bold"/>
            <ImageButton Source="menu_icon.png" Grid.Column="2" HeightRequest="24" BackgroundColor="Transparent"/>
        </Grid>

        <!-- Lista de PDFs -->
        <ScrollView Grid.Row="1" Padding="20">
            <StackLayout x:Name="PdfStack" Spacing="15">
                <Label x:Name="lblTituloCarpeta" Text="Categoría:" FontAttributes="Bold" FontSize="18" TextColor="#003366" />
                <!-- Aqui se agregan dinamicamente los PDFs -->
            </StackLayout>
        </ScrollView>

        <!-- Pie de pagina -->
        <Grid Grid.Row="2" BackgroundColor="#00224D" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="accessibility_icon.png" HeightRequest="20" VerticalOptions="Center"/>
            <StackLayout Grid.Column="1" Padding="10,0">
                <Label Text="Plataforma gestionada por funcionarios de RIPSSHA, CCSS." TextColor="White" FontSize="12"/>
                <Label Text="No es un sitio oficial. Copyright © 2025 | ARCA" TextColor="White" FontSize="12"/>
            </StackLayout>
            <Image Source="alert_icon.png" HeightRequest="20" Grid.Column="2" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
