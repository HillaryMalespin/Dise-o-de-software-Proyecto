<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ARCAMovil.Pages.ContactoPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,20">

                <Grid BackgroundColor="#F5F5F5" HeightRequest="50" Padding="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="logo_arca.png" HeightRequest="30" VerticalOptions="Center" />
                    <Label Text="Contactos" Grid.Column="1" FontSize="20" TextColor="Black" VerticalOptions="Center" HorizontalOptions="Center" FontAttributes="Bold"/>
                    <ImageButton Source="menu_icon.png" Grid.Column="2" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent" VerticalOptions="Center" Clicked="OnMenuClicked" />
                </Grid>

                <Label Text="Centro de Contacto:"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#333"
                       HorizontalOptions="Center" />

                <Border Stroke="#007bff"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 8"
                        Padding="15"
                        Margin="20,0">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Informacion General:" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                        <Label Text="Dirección: Calle 123, CIUDAD" FontSize="14" />
                        <Label Text="Teléfono: +506 4561 7890" FontSize="14" />
                        <Label Text="Email: contacto@institucion.cr" FontSize="14" />
                        <Label Text="Horario: L-V, 9:00-17:00" FontSize="14" />

                        <BoxView HeightRequest="1" Color="#e0e0e0" Margin="0,10" />

                        <Label Text="Política de privacidad" TextColor="#007bff" TextDecorations="Underline" FontSize="14" />
                        <Label Text="Términos de uso" TextColor="#007bff" TextDecorations="Underline" FontSize="14" />
                        <Label Text="Manual de usuario" TextColor="#007bff" TextDecorations="Underline" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Formulario de Sugerencias"
                        Clicked="OnFormularioClicked"
                        CornerRadius="20"
                        HorizontalOptions="Center"
                        BackgroundColor="#f0f0f0"
                        TextColor="Black"
                        BorderColor="LightGray"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        Padding="20,10"/>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,10,0,0">
                    <ImageButton Source="instagram_icon.png" HeightRequest="30" WidthRequest="30" />
                    <ImageButton Source="facebook_icon.png" HeightRequest="30" WidthRequest="30" />
                    <ImageButton Source="x_icon.png" HeightRequest="30" WidthRequest="30" />
                    <ImageButton Source="spotify_icon.png" HeightRequest="30" WidthRequest="30" />
                    <ImageButton Source="linkedin_icon.png" HeightRequest="30" WidthRequest="30" />
                    <ImageButton Source="whatsapp_icon.png" HeightRequest="30" WidthRequest="30" />
                    <ImageButton Source="telegram_icon.png" HeightRequest="30" WidthRequest="30" />
                    <ImageButton Source="tiktok_icon.png" HeightRequest="30" WidthRequest="30" />
                    <ImageButton Source="youtube_icon.png" HeightRequest="30" WidthRequest="30" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" BackgroundColor="#00224D" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="accessibility_icon.png" HeightRequest="20" VerticalOptions="Center"/>
            <StackLayout Grid.Column="1" Padding="10,0">
                <Label Text="Plataforma gestionada por funcionarios de RIPSSHA, CCSS." TextColor="White" FontSize="12"/>
                <Label Text="No es un sitio oficial. Copyright © 2025 | ARCA" TextColor="White" FontSize="12"/>
            </StackLayout>
        </Grid>

    </Grid>
</ContentPage>